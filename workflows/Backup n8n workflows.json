    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const workflow = item.json;\n  const safeName = (workflow.name || `workflow-${workflow.id}`)\n    .replace(/[\\/\\\\:*?\"<>|]/g, '_');\n  results.push({\n    json: {\n      fileName: `${safeName}.json`,\n      workflowJson: JSON.stringify(workflow, null, 2)\n    }\n  });\n}\nreturn results;"
      },
